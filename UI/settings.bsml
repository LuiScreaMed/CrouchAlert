<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <vertical vertical-fit="PreferredSize">
        <toggle-setting
                id="enableToggle"
                value="EnableValue"
                apply-on-change="true"
                text-key="CROUCH_ALERT_ENABLE"
                hover-hint-key="CROUCH_ALERT_ENABLE_HINT"
        />
        <toggle-setting
                id="useStrictModeToggle"
                value="UseStrictModeValue"
                apply-on-change="true"
                text-key="CROUCH_ALERT_STRICT_MODE"
                hover-hint-key="CROUCH_ALERT_STRICT_MODE_HINT"
        />
        <slider-setting
                id="remindBeforeDurationIncrement"
                value="RemindBeforeDurationValue"
                apply-on-change="true"
                min="0.5"
                max="3.0"
                increment="0.05"
                show-buttons="true"
                formatter="FormatDuration"
                text-key="CROUCH_ALERT_ALERT_DURATION"
                hover-hint-key="CROUCH_ALERT_ALERT_DURATION_HINT"
        />
        <slider-setting
                id="extendWallsByDurationIncrement"
                value="ExtendWallsByDurationValue"
                apply-on-change="true"
                min="0.1"
                max="0.75"
                increment="0.05"
                show-buttons="true"
                formatter="FormatDuration"
                text-key="CROUCH_ALERT_EXTEND_WALLS_BY_DURATION"
                hover-hint-key="CROUCH_ALERT_EXTEND_WALLS_BY_DURATION_HINT"
        />
        <toggle-setting
                id="enableRemindSoundToggle"
                value="EnableRemindSoundValue"
                apply-on-change="true"
                text-key="CROUCH_ALERT_ENABLE_ALERT_SOUND"
                hover-hint-key="CROUCH_ALERT_ENABLE_ALERT_SOUND_HINT"
        />
        <dropdown-list-setting
                id="remindSoundAudioClipDropdown"
                value="RemindSoundAudioClipValue"
                apply-on-change="true"
                options="RemindSoundAudioClipOptions"
                text-key="CROUCH_ALERT_ALERT_SOUND_AUDIO_CLIP"
                hover-hint-key="CROUCH_ALERT_ALERT_SOUND_AUDIO_CLIP_HINT"
                get-event="updateAudioClipOptions"
        />
        <text
                id="remindSoundAudioClipNotFoundText"
                text-key="CROUCH_ALERT_ALERT_SOUND_AUDIO_CLIP_NOT_FOUND"
                font-size="3.5"
                color="red"
                align="BaselineRight"
        />
        <slider-setting
                id="remindSoundVolumeSlider"
                value="RemindSoundVolumeValue"
                apply-on-change="true"
                min="0.0"
                max="1.0"
                increment="0.1"
                show-buttons="true"
                text-key="CROUCH_ALERT_ALERT_SOUND_VOLUME"
                hover-hint-key="CROUCH_ALERT_ALERT_SOUND_VOLUME_HINT"
        />
    </vertical>
</bg>