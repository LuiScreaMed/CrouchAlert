<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd' id="background"
    bg="round-rect-panel" bg-alpha="~BackgroundAlpha">
    <vertical child-align="MiddleCenter" vertical-fit="PreferredSize">
        <text id="crouchText" text-key="CROUCH_ALERT_CROUCH_TEXT" font-size="18" bold="true"/>
        <text id="countDownText" text="~CountDownText" font-size="12" bold="false" align="Center"
              active="~DisplayTimer"/>
    </vertical>
    <image id="progressBarLeft" image-color="white" active="~DisplayProgressBar" anchor-min-x="0" anchor-min-y="0"
        anchor-max-x="0" anchor-max-y="1" pivot-x="0" anchor-pos-x="0" size-delta-x="~ProgressBarWidth" size-delta-y="50"/>
    <image id="progressBarRight" ignore-layout="true" image-color="white" active="~DisplayProgressBar" anchor-min-x="1" anchor-min-y="0"
        anchor-max-x="1" anchor-max-y="1" pivot-x="1" anchor-pos-x="0" size-delta-x="~ProgressBarWidth" size-delta-y="50"/>
</bg>