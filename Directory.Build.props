<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

  <!-- Plugin Metadata -->
  <PropertyGroup>
    <PluginId>CrouchAlert</PluginId>
    <PluginName>CrouchAlert</PluginName>
    <Authors>LuiScreaMed</Authors>
    <Version>1.0.1</Version>
    <GameVersion>1.40.8</GameVersion>
    <Description>A Beat Saber mod to alert incoming crouching walls.</Description>
    <!--<PluginIcon></PluginIcon>-->
    <ProjectSource>https://github.com/LuiScreaMed/CrouchAlert</ProjectSource>
    <!--<ProjectHome></ProjectHome>-->
    <!--<DonateUrl></DonateUrl>-->
  </PropertyGroup>

  <!-- Plugin Dependencies -->
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0"/>
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.12.0"/>
    <DependsOn Include="SiraUtil" Version="^3.1.0"/>
    <DependsOn Include="CustomJSONData" Version="^2.6.8"/>
  </ItemGroup>
  
  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>
  
</Project>